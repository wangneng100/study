# Copy this file to .env and fill in what you need. .env is ignored by git.

# 1min.ai API key. When set, translations and example sentences come from 1min.ai.
ONEMIN_API_KEY=

# 1min.ai chat model used for lookups.
ONEMIN_MODEL=gpt-4o-mini

# auto   = 1min.ai when a key is set, falling back to Google Translate
# onemin = 1min.ai only
# google = Google Translate only (no key needed)
TRANSLATOR=auto

PORT=8765
